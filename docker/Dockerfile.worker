FROM golang:1.24-alpine AS builder

# gcc + musl-dev needed for cgo-based docker SDK calls
RUN apk add --no-cache gcc musl-dev git

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download && go mod verify

COPY . .

# CGO_ENABLED=0 keeps the binary self-contained; docker socket calls are pure Go
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-w -s" \
    -trimpath \
    -o worker \
    ./cmd/worker/main.go

# ---- Final stage ----
FROM debian:bookworm-slim

# Install minimal runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -r -u 10001 -s /bin/false -d /nonexistent -c "Worker service account" worker

COPY --from=builder /app/worker /worker

# Ensure binary is executable and owned correctly
RUN chmod 555 /worker && chown worker:worker /worker

USER worker

EXPOSE 8081

ENTRYPOINT ["/worker"]
