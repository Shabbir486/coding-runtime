{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CodeRuntimeSQS",
      "Effect": "Allow",
      "Action": [
        "sqs:SendMessage",
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:ChangeMessageVisibility",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl"
      ],
      "Resource": [
        "arn:aws:sqs:ap-southeast-2:768054003064:code-submission-processing-queue",
        "arn:aws:sqs:ap-southeast-2:768054003064:code-submission-completed-queue"
      ]
    }
  ]
}
