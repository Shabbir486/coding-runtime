NODE_SG=$(aws ec2 describe-instances --region ap-southeast-2 \
  --filters Name=tag:eks:nodegroup-name,Values=system Name=instance-state-name,Values=running \
  --query 'Reservations[0].Instances[0].SecurityGroups[0].GroupId' --output text)   # sg-0d05392d14f525ff9
aws ec2 authorize-security-group-ingress --region ap-southeast-2 \
  --group-id sg-089caf4f4cdf7be6e --protocol tcp --port 3306 --source-group "$NODE_SG"
```

## Phase 4 — push images to ECR (nodes are amd64; local images are arm64 → rebuild)
```bash
ACCOUNT=768054003064; REGION=ap-southeast-2; ECR=$ACCOUNT.dkr.ecr.$REGION.amazonaws.com
for s in api worker queue-manager; do aws ecr create-repository --repository-name coderuntime/$s --region $REGION || true; done
aws ecr get-login-password --region $REGION | docker login --username AWS --password-stdin $ECR
docker buildx build --platform linux/amd64 -f docker/Dockerfile.api           -t $ECR/coderuntime/api:v1 --push .
docker buildx build --platform linux/amd64 -f docker/Dockerfile.worker        -t $ECR/coderuntime/worker:v1 --push .
docker buildx build --platform linux/amd64 -f docker/Dockerfile.queue-manager -t $ECR/coderuntime/queue-manager:v1 --push .
```

## Phase 5 — deploy app (api + queue-manager + redis; worker held)
```bash
kubectl apply -f - <<SC   # fast-ssd StorageClass on EKS = EBS gp3
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata: {name: fast-ssd}
provisioner: ebs.csi.aws.com
parameters: {type: gp3}
volumeBindingMode: WaitForFirstConsumer
SC
# secrets: DB(RDS coderuntime-prod)+JWT+redis pwd; NO aws-credentials (IRSA)
kubectl create secret generic api-secrets -n coderuntime --from-literal=DATABASE_HOST=<rds> ... 
kubectl apply -k .                       # base (ECR images via kustomization)
kubectl label ns coderuntime pod-security.kubernetes.io/enforce=privileged --overwrite
kubectl -n coderuntime patch limitrange coderuntime-limits ... min 10m/16Mi
# re-annotate IRSA SAs (namespace.yaml clobbers them), strip AWS_* env (use IRSA), hold worker
for sa in api-gateway worker queue-manager; do kubectl -n coderuntime annotate sa $sa eks.amazonaws.com/role-arn=<arn> --overwrite; done
for d in api-gateway queue-manager worker; do kubectl -n coderuntime get deploy $d -o json | jq 'del AWS_* env' | kubectl apply -f -; done
kubectl -n coderuntime scale deployment worker --replicas=0     # AL2023 has no docker.sock
# api anti-affinity required→preferred (2-node cluster, avoids rollout deadlock)
```

## Phase 5a — FIX: EBS CSI driver missing (redis PVC stuck Pending)
```bash
# Symptom: kubectl get pvc → redis-data-redis-0 Pending; no ebs-csi pods;
#          aws eks describe-addon aws-ebs-csi-driver → "No addon found"
# (the first failed cluster-create skipped the addon). Install with IRSA:
eksctl create iamserviceaccount --cluster coderuntime --region ap-southeast-2 \
  --namespace kube-system --name ebs-csi-controller-sa \
  --attach-policy-arn arn:aws:iam::aws:policy/service-role/AmazonEBSCSIDriverPolicy \
  --role-only --role-name AmazonEKS_EBS_CSI_DriverRole_coderuntime --approve
eksctl create addon --cluster coderuntime --region ap-southeast-2 --name aws-ebs-csi-driver \
  --service-account-role-arn arn:aws:iam::768054003064:role/AmazonEKS_EBS_CSI_DriverRole_coderuntime --force
```

## Phase 5b — FIX: RDS database didn't exist (api Error 1049)
```bash
# api connected to RDS but: Error 1049 (42000): Unknown database 'coderuntime'.
# App auto-creates TABLES, not the DATABASE. RDS instance had no initial DB.
# Create it from an in-cluster pod (laptop can't reach the private RDS):
kubectl run mysql-init -n coderuntime --restart=Never --image=mysql:8 --command -- \
  mysql -h coderuntime-prod.cziyoeg0oioy.ap-southeast-2.rds.amazonaws.com \
  -u coderuntime -pcoderuntime123 -e "CREATE DATABASE IF NOT EXISTS coderuntime;"
kubectl -n coderuntime rollout restart deployment/api-gateway   # → migrates + seeds
```

