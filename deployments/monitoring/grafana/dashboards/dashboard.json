            "uid": "prometheus-ds"
          },
          "expr": "100 * (sum(rate(code_runtime_queue_jobs_consumed_total{status=\"Accepted\"}[5m])) or on() vector(0)) / (sum(rate(code_runtime_queue_jobs_consumed_total[5m])) > 0)",
